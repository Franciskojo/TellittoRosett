# Copy to .env (never commit .env)

# MongoDB connection string. Use a dedicated DB user with a strong, unique password.
MONGODB_URI=mongodb+srv://<user>:<strong-password>@<cluster>/<db>?retryWrites=true&w=majority

# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: seed demo users/data. Always seeded in development; NEVER enable in production.
# SEED_DEMO_DATA=false
